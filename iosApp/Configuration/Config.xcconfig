TEAM_ID=

PRODUCT_NAME=EducationApp
PRODUCT_BUNDLE_IDENTIFIER=com.example.educationapp.EducationApp$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Base API URL per build configuration (Debug vs Release)
// Note: /$()/ is used to escape // so Xcode does not treat it as a comment
BASE_URL_Debug = http:/$()/10.11.11.212:8085/api/v1/
BASE_URL_Release = http:/$()/cnxvn.ddns.net:9000/api/v1/
BASE_URL = $(BASE_URL_$(CONFIGURATION))